/*
========================================================================================
    conf/base.config
    Default CPU / memory / time per process label.
    Override in slurm.config or by adding withName blocks here.
========================================================================================
*/

process {

    // ── Defaults for every process ──────────────────────────────────────────
    cpus   = { 1    * task.attempt }
    memory = { 4.GB * task.attempt }
    time   = { 2.h  * task.attempt }

    // Retry on OOM or killed-by-scheduler exit codes
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // ── Process labels ───────────────────────────────────────────────────────

    withLabel: process_single {
        cpus   = 1
        memory = { 4.GB  * task.attempt }
        time   = { 1.h   * task.attempt }
    }

    withLabel: process_medium {
        cpus   = { 4 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withLabel: process_high {
        cpus   = { 8 * task.attempt }
        memory = { 40.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withLabel: process_long {
        time   = { 24.h  * task.attempt }
    }

    // ── Per-process overrides ────────────────────────────────────────────────

    withName: 'STAR_ALIGN' {
        cpus   = { params.threads }
        memory = { (params.star_ram as int).GB * task.attempt }
        time   = { 12.h * task.attempt }
    }

    withName: 'FEATURECOUNTS' {
        cpus   = { params.threads }
        memory = { 8.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }

    withName: 'DESEQ2' {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }

    withName: 'MULTIQC' {
        cpus   = 1
        memory = { 4.GB  * task.attempt }
        time   = { 1.h   * task.attempt }
    }
}

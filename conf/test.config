/*
========================================================================================
    conf/test.config
    Minimal test-run parameters — activate with:  -profile test
    Expects small test FASTQ files in test/data/ and a tiny STAR index.
========================================================================================
*/

params {
    reads        = "${projectDir}/test/data/*_{1,2}.fastq.gz"
    gtf          = "${projectDir}/test/data/test.gtf"
    star_index   = "${projectDir}/test/data/star_index"
    samplesheet  = "${projectDir}/test/samplesheet.csv"
    outdir       = "test_results"
    threads      = 2
    star_ram     = 8
}

process {
    cpus   = 2
    memory = { 8.GB * task.attempt }
    time   = { 30.min * task.attempt }

    withName: 'STAR_ALIGN' {
        memory = { 8.GB * task.attempt }
    }
}

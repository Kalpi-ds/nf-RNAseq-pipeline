/*
========================================================================================
    RNAseq-pipeline — nextflow.config
    Master configuration: parameters, process labels, execution profiles

    Author:  Kalpani De Silva (kdesilva@wi.mit.edu)
    Group:   Bioinformatics and Research Computing (BaRC), Whitehead Institute
    Date:    March 2026
========================================================================================
*/

nextflow.enable.dsl = 2

// ─── Global parameters ───────────────────────────────────────────────────────
params {

    // Input / output
    reads             = "*.fastq.gz"
    single_end        = false
    outdir            = "results"
    genome            = null
    gtf               = null
    star_index        = null

    // Trimming
    min_length        = 20
    quality_cutoff    = 20
    skip_trimming     = false

    // Alignment
    threads           = 8
    star_ram          = 40
    star_twopass      = false
    align_intron_min  = 20
    align_intron_max  = 1000000
    align_mates_gap   = 1000000

    // Strandedness
    // Provide --bed to auto-detect; otherwise set --fc_strandedness manually
    // (0=unstranded, 1=forward, 2=reverse-stranded)
    bed                  = null
    fc_strandedness      = 0

    // Quantification
    fc_group_features    = "gene_id" // GTF attribute to group features
    fc_extra_attributes  = null      // e.g. "gene_name" for extra annotation columns

    // Differential expression
    samplesheet       = null
    condition_col     = "condition"
    control_group     = null        // e.g. "WT" — the reference/control condition for DESeq2
    skip_deseq2       = false

    // DESeq2 thresholds
    lfc_threshold     = 1.0
    padj_cutoff       = 0.05

    // Gene ID → gene name conversion (id_to_name.py)
    // Set --annotation to a tab-delimited mapping file (gene_id in col 1,
    // gene name in a column named by --annotation_key).
    annotation        = null
    annotation_key    = "Gene name"

    // Heatmap of significant DE genes (cluster_draw_pheatmap.R)
    skip_pheatmap     = false

    // MultiQC
    multiqc_config    = "${projectDir}/assets/multiqc_config.yml"

    // Pipeline metadata
    pipeline_version  = "2.0"
}

// ─── Work directory ─────────────────────────────────────────────────────────
// Uses the Nextflow default: ./work relative to the launch directory.
// Keeping work/ separate from --outdir means -resume cache survives if results are deleted.

// ─── Include base resource config ────────────────────────────────────────────
includeConfig 'conf/base.config'

// ─── Execution profiles ───────────────────────────────────────────────────────
profiles {

    standard {
        process.executor = 'local'
    }

    slurm {
        includeConfig 'conf/slurm.config'
    }

    conda {
        conda.enabled   = true
        conda.useMamba  = false
        // Pre-built shared environment for Whitehead Institute cluster users.
        // External users: replace with your own env path, or build from environment.yml:
        //   conda env create -f environment.yml
        //   then set: process.conda = "/path/to/your/env"
        process.conda   = "/nfs/BaRC_Public/virtualEnvironments/RNAseq-pipeline"
    }

    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        singularity.pullTimeout = '2 h'
        singularity.cacheDir    = "${HOME}/.singularity/cache"
        docker.enabled          = false
        process.container       = "${projectDir}/singularity_cache/rnaseqpipe-portable-2.0.sif"
    }

    // ── Cluster profile: SLURM + Singularity in one command ──────────────────
    // Usage: nextflow run <pipeline>/main.nf -profile cluster --reads ...
    cluster {
        includeConfig 'conf/slurm.config'
        singularity.enabled     = true
        singularity.autoMounts  = true
        singularity.pullTimeout = '2 h'
        singularity.cacheDir    = "${projectDir}/singularity_cache"
        docker.enabled          = false
        process.container       = "${projectDir}/singularity_cache/rnaseqpipe-portable-2.0.sif"
    }

    test {
        includeConfig 'conf/test.config'
    }
}

// ─── Pipeline execution reports ──────────────────────────────────────────────
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}

// ─── Manifest ────────────────────────────────────────────────────────────────
manifest {
    name            = 'RNAseq-pipeline'
    author          = 'KdeSilva — Whitehead Institute'
    description     = 'End-to-end RNA-seq pipeline: FASTQ → QC → Align → Quantify → DESeq2'
    version         = '2.0'
    nextflowVersion = '>=22.10.0'
    homePage        = '/nfs/BaRC_Public/BaRC_code/pipelines/RNAseq-pipeline'
}
